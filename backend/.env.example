# Copy to .env. The scheme must be postgresql+psycopg.
# Local Postgres from `docker compose up -d db`:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/salary_management
# Supabase transaction pooler (port 6543), for deployments:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
